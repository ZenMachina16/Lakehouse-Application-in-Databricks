                  "fields": [
                    {
                      "name": "daily(order_date)",
                      "expression": "DATE_TRUNC(\"DAY\", `order_date`)"
                    },
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
